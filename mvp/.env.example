# stub outside the intranet; local_relay for a local HTTP model proxy; nga after the internal adapter is implemented
LLM_PROVIDER=stub

# Used when LLM_PROVIDER=local_relay, nga, or legacy openai_compatible
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=glm-4.7
LLM_TIMEOUT_SECONDS=120

# PPT renderer: stub outside the intranet; hw_skill after Huawei Skill is wired
PPT_RENDERER=stub
PPT_COMPLIANCE_GATE=warn
USE_LANGGRAPH=false

# Optional preview export tools
SOFFICE_PATH=
PDFTOPPM_PATH=

# Generation defaults
DEFAULT_TARGET_SLIDES=8
MAX_INPUT_CHARS=60000
MAX_REPAIR_ATTEMPTS=2

# Paths
STYLE_PROFILE=doc_agent/styles/style_profile.yaml
TEMPLATE_PPTX=templates/company_template.pptx
REFERENCE_DOCX=templates/reference.docx
DATA_DIR=data
OUTPUT_DIR=outputs
LOG_DIR=data/logs
LOG_LEVEL=INFO

# API server and browser CORS
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Debug
SAVE_DEBUG_ARTIFACTS=true
