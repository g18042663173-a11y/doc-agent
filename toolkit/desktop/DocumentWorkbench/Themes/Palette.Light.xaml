<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows Settings-inspired light palette. Product red stays limited to the mark. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#DCEBFA" />
    <SolidColorBrush x:Key="NavigationTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="NavigationMutedTextBrush" Color="#616161" />
    <SolidColorBrush x:Key="NavigationBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#707070" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="AccentOnDarkBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ProductMarkBrush" Color="#C7000B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F1C5C1" />
    <SolidColorBrush x:Key="FocusBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F3F9FD" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#DCEBFA" />
</ResourceDictionary>
