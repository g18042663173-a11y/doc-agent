<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows Settings-inspired dark palette. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#333333" />
    <SolidColorBrush x:Key="InputBrush" Color="#292929" />
    <SolidColorBrush x:Key="NavigationBrush" Color="#202020" />
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#323232" />
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#28425C" />
    <SolidColorBrush x:Key="NavigationTextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="NavigationMutedTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="NavigationBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#76D0FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2EA8E6" />
    <SolidColorBrush x:Key="AccentOnDarkBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="ProductMarkBrush" Color="#C7000B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2C94C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#6F3B43" />
    <SolidColorBrush x:Key="FocusBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#777777" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#323C45" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#28425C" />
</ResourceDictionary>
