<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reloaded on system preference changes so WPF follows high-contrast colors. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NavigationBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="NavigationTextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="NavigationMutedTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="NavigationBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentOnDarkBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="ProductMarkBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
