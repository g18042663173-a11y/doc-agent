{
  "$defs": {
    "FailureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 16,
          "minLength": 3,
          "pattern": "^[A-Z][A-Z0-9-]+$",
          "title": "Code",
          "type": "string"
        },
        "failure_envelope_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Failure Envelope Version",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/FailureItem"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        },
        "loc": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loc"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        },
        "support_id": {
          "pattern": "^SUP-[0-9A-F]{12}$",
          "title": "Support Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "retryable",
        "message",
        "suggestion",
        "support_id"
      ],
      "title": "FailureEnvelope",
      "type": "object"
    },
    "FailureItem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 16,
          "minLength": 3,
          "pattern": "^[A-Z][A-Z0-9-]+$",
          "title": "Code",
          "type": "string"
        },
        "level": {
          "default": "Error",
          "enum": [
            "Error",
            "Warning",
            "Info"
          ],
          "title": "Level",
          "type": "string"
        },
        "loc": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Loc",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "code",
        "loc",
        "message",
        "suggestion"
      ],
      "title": "FailureItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Path"
    },
    "asset_manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Manifest Path"
    },
    "assets": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Assets",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "depth": {
      "anyOf": [
        {
          "enum": [
            "概览",
            "标准",
            "详细"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Depth"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "generator_name": {
      "default": "stub",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Generator Name",
      "type": "string"
    },
    "generator_revision": {
      "default": 0,
      "minimum": 0,
      "title": "Generator Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "job_id": {
      "pattern": "^job-[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "job_state_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Job State Version",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "report": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report"
    },
    "stage": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "enum": [
        "word",
        "deck"
      ],
      "title": "Target",
      "type": "string"
    },
    "template_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Path"
    },
    "template_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Summary"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "target",
    "status",
    "stage",
    "progress_percent",
    "created_at",
    "updated_at"
  ],
  "title": "JobState",
  "type": "object"
}
