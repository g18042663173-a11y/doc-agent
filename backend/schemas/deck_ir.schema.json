{
  "$defs": {
    "AgendaSlide": {
      "properties": {
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Items",
          "type": "array"
        },
        "layout": {
          "const": "agenda",
          "title": "Layout",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "items"
      ],
      "title": "AgendaSlide",
      "type": "object"
    },
    "ArchitectureDiagramSlide": {
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/ArchitectureEdge"
          },
          "maxItems": 24,
          "title": "Edges",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/ArchitectureGroup"
          },
          "maxItems": 6,
          "title": "Groups",
          "type": "array"
        },
        "layout": {
          "const": "architecture_diagram",
          "title": "Layout",
          "type": "string"
        },
        "manual_hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchitectureManualHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ArchitectureNode"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "title",
        "nodes",
        "edges",
        "groups"
      ],
      "title": "ArchitectureDiagramSlide",
      "type": "object"
    },
    "ArchitectureEdge": {
      "properties": {
        "direction": {
          "default": "forward",
          "enum": [
            "forward",
            "backward",
            "both",
            "none"
          ],
          "title": "Direction",
          "type": "string"
        },
        "from": {
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "style": {
          "default": "solid",
          "enum": [
            "solid",
            "dashed"
          ],
          "title": "Style",
          "type": "string"
        },
        "to": {
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "ArchitectureEdge",
      "type": "object"
    },
    "ArchitectureGroup": {
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Node Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "node_ids"
      ],
      "title": "ArchitectureGroup",
      "type": "object"
    },
    "ArchitectureManualHints": {
      "properties": {
        "node_positions": {
          "additionalProperties": {
            "$ref": "#/$defs/DiagramPosition"
          },
          "description": "按节点 id 覆盖 nodes[].position；不是在原坐标上追加偏移。",
          "maxProperties": 12,
          "title": "Node Positions",
          "type": "object"
        },
        "node_sizes": {
          "additionalProperties": {
            "$ref": "#/$defs/DiagramSize"
          },
          "description": "按节点 id 覆盖 nodes[].size；不是在原尺寸上追加缩放。",
          "maxProperties": 12,
          "title": "Node Sizes",
          "type": "object"
        }
      },
      "title": "ArchitectureManualHints",
      "type": "object"
    },
    "ArchitectureNode": {
      "properties": {
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagramPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选节点中心位置；坐标相对架构图内容区归一化。"
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagramSize"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选节点尺寸；宽高分别是架构图内容区宽高的比例。"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "default": "secondary",
          "enum": [
            "primary",
            "secondary",
            "emphasis",
            "data"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ArchitectureNode",
      "type": "object"
    },
    "Card": {
      "properties": {
        "desc": {
          "minLength": 1,
          "title": "Desc",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "desc"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardsSlide": {
      "properties": {
        "cards": {
          "items": {
            "$ref": "#/$defs/Card"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Cards",
          "type": "array"
        },
        "layout": {
          "const": "cards",
          "title": "Layout",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "title",
        "cards"
      ],
      "title": "CardsSlide",
      "type": "object"
    },
    "ChartSeries": {
      "properties": {
        "emphasis": {
          "default": false,
          "title": "Emphasis",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "values": {
          "description": "系列数值；与 thresholds[].value 使用相同数值单位。",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartSideTable": {
      "properties": {
        "header": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Header",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 6,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "header"
      ],
      "title": "ChartSideTable",
      "type": "object"
    },
    "ChartSlide": {
      "properties": {
        "chart": {
          "$ref": "#/$defs/ChartSpec"
        },
        "layout": {
          "const": "chart",
          "title": "Layout",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "title",
        "chart"
      ],
      "title": "ChartSlide",
      "type": "object"
    },
    "ChartSpec": {
      "properties": {
        "categories": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "kind": {
          "enum": [
            "bar",
            "line",
            "pie"
          ],
          "title": "Kind",
          "type": "string"
        },
        "legend_position": {
          "default": "top",
          "enum": [
            "top",
            "right",
            "none"
          ],
          "title": "Legend Position",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "show_data_labels": {
          "default": true,
          "title": "Show Data Labels",
          "type": "boolean"
        },
        "side_conclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side Conclusion"
        },
        "side_table": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSideTable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thresholds": {
          "items": {
            "$ref": "#/$defs/ChartThreshold"
          },
          "maxItems": 4,
          "title": "Thresholds",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "仅用于坐标轴和数据/阈值标签的显示后缀，不执行单位换算。",
          "title": "Unit"
        }
      },
      "required": [
        "kind",
        "categories",
        "series"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "ChartThreshold": {
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "description": "阈值数值；必须与 chart.series[].values 使用相同数值单位。",
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ChartThreshold",
      "type": "object"
    },
    "ColumnContent": {
      "properties": {
        "bullets": {
          "items": {
            "$ref": "#/$defs/ListItem"
          },
          "maxItems": 7,
          "title": "Bullets",
          "type": "array"
        },
        "heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "ColumnContent",
      "type": "object"
    },
    "ConclusionSlide": {
      "properties": {
        "bullets": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Bullets",
          "type": "array"
        },
        "cta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cta"
        },
        "layout": {
          "const": "conclusion",
          "title": "Layout",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "title"
      ],
      "title": "ConclusionSlide",
      "type": "object"
    },
    "CoverSlide": {
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "layout": {
          "const": "cover",
          "title": "Layout",
          "type": "string"
        },
        "presenter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Presenter"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "title"
      ],
      "title": "CoverSlide",
      "type": "object"
    },
    "DeckMeta": {
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "classification": {
          "default": "HUAWEI CONFIDENTIAL",
          "title": "Classification",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "theme": {
          "default": "hw_v1",
          "title": "Theme",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "DeckMeta",
      "type": "object"
    },
    "DeckTable": {
      "properties": {
        "cell_spans": {
          "items": {
            "$ref": "#/$defs/TableCellSpan"
          },
          "maxItems": 16,
          "title": "Cell Spans",
          "type": "array"
        },
        "col_widths": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "各列的正数相对宽度权重；渲染时归一化到版心可用宽度，不是英寸或其它绝对单位。",
          "title": "Col Widths"
        },
        "column_groups": {
          "items": {
            "$ref": "#/$defs/TableColumnGroup"
          },
          "maxItems": 4,
          "title": "Column Groups",
          "type": "array"
        },
        "conclusion_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "结论列的 0 起始列索引。",
          "title": "Conclusion Col"
        },
        "header": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Header",
          "type": "array"
        },
        "row_groups": {
          "items": {
            "$ref": "#/$defs/TableRowGroup"
          },
          "maxItems": 8,
          "title": "Row Groups",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DeckTableCell"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "array"
          },
          "maxItems": 12,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "header"
      ],
      "title": "DeckTable",
      "type": "object"
    },
    "DeckTableCell": {
      "properties": {
        "emphasis": {
          "anyOf": [
            {
              "enum": [
                "yellow",
                "cyan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emphasis"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Items",
          "type": "array"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "DeckTableCell",
      "type": "object"
    },
    "DiagramPosition": {
      "properties": {
        "x": {
          "description": "节点中心相对架构图内容区宽度的归一化横坐标。",
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "节点中心相对架构图内容区高度的归一化纵坐标。",
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "DiagramPosition",
      "type": "object"
    },
    "DiagramSize": {
      "properties": {
        "height": {
          "description": "节点高度占架构图内容区高度的比例。",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "description": "节点宽度占架构图内容区宽度的比例。",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "DiagramSize",
      "type": "object"
    },
    "ImageSlide": {
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Ref"
        },
        "layout": {
          "const": "image",
          "title": "Layout",
          "type": "string"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "title"
      ],
      "title": "ImageSlide",
      "type": "object"
    },
    "ListItem": {
      "properties": {
        "level": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ListItem",
      "type": "object"
    },
    "SectionSlide": {
      "properties": {
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "layout": {
          "const": "section",
          "title": "Layout",
          "type": "string"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "index",
        "title"
      ],
      "title": "SectionSlide",
      "type": "object"
    },
    "TableCellSpan": {
      "properties": {
        "area": {
          "default": "body",
          "enum": [
            "header",
            "body"
          ],
          "title": "Area",
          "type": "string"
        },
        "col": {
          "description": "合并区域起始列的 0 起始索引。",
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "description": "合并区域覆盖的列数量，不是结束列索引。",
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "row": {
          "description": "合并区域起始行的 0 起始索引；header 区固定从 0 行开始。",
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "description": "合并区域覆盖的行数量，不是结束行索引。",
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "TableCellSpan",
      "type": "object"
    },
    "TableColumnGroup": {
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "span": {
          "description": "分组覆盖的列数量，不是结束列索引。",
          "minimum": 1,
          "title": "Span",
          "type": "integer"
        },
        "start_col": {
          "description": "分组起始列的 0 起始索引。",
          "minimum": 0,
          "title": "Start Col",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "start_col",
        "span"
      ],
      "title": "TableColumnGroup",
      "type": "object"
    },
    "TableRowGroup": {
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
