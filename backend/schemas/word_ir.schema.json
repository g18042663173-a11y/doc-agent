{
  "$defs": {
    "BulletListBlock": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "bullet_list",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "BulletListBlock",
      "type": "object"
    },
    "CodeBlock": {
      "properties": {
        "code": {
          "description": "保留原始换行和行首缩进的源码文本，不得按普通段落合并或 strip。",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选语言标记，例如 c、cpp 或 python；仅供阅读与解析追溯。",
          "title": "Language"
        },
        "type": {
          "const": "code_block",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "code"
      ],
      "title": "CodeBlock",
      "type": "object"
    },
    "ControlRecord": {
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "对应人员的日期；为空时保留空白占位单元格。",
          "title": "Date"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "拟制、审核或批准人员姓名；为空时保留空白占位单元格。",
          "title": "Name"
        }
      },
      "title": "ControlRecord",
      "type": "object"
    },
    "DocumentControl": {
      "properties": {
        "approved": {
          "$ref": "#/$defs/ControlRecord",
          "description": "批准人员与日期。"
        },
        "classification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "文档头展示的密级；省略时使用 meta.classification，填写时必须与其一致。",
          "title": "Classification"
        },
        "document_name": {
          "description": "文档名称，通常与 meta.title 一致但可按正式名称单独填写。",
          "minLength": 1,
          "title": "Document Name",
          "type": "string"
        },
        "prepared": {
          "$ref": "#/$defs/ControlRecord",
          "description": "拟制人员与日期。"
        },
        "product_name": {
          "description": "产品名称，渲染在文档控制信息表第一行。",
          "minLength": 1,
          "title": "Product Name",
          "type": "string"
        },
        "reviewed": {
          "$ref": "#/$defs/ControlRecord",
          "description": "审核人员与日期。"
        },
        "version": {
          "description": "文档版本号，例如 V1.0。",
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "product_name",
        "document_name",
        "version"
      ],
      "title": "DocumentControl",
      "type": "object"
    },
    "HeadingBlock": {
      "properties": {
        "level": {
          "maximum": 4,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "heading",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "text"
      ],
      "title": "HeadingBlock",
      "type": "object"
    },
    "ImagePlaceholderBlock": {
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "type": {
          "const": "image_placeholder",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ImagePlaceholderBlock",
      "type": "object"
    },
    "ListItem": {
      "properties": {
        "level": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ListItem",
      "type": "object"
    },
    "NumberedListBlock": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "numbered_list",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "NumberedListBlock",
      "type": "object"
    },
    "PageBreakBlock": {
      "properties": {
        "type": {
          "const": "page_break",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PageBreakBlock",
      "type": "object"
    },
    "ParagraphBlock": {
      "properties": {
        "style": {
          "default": "normal",
          "enum": [
            "normal",
            "quote",
            "note"
          ],
          "title": "Style",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "paragraph",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "ParagraphBlock",
      "type": "object"
    },
    "TableBlock": {
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "col_widths": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "各列的正数相对宽度权重；渲染时归一化到可用表宽，不是英寸或其它绝对单位。",
          "title": "Col Widths"
        },
        "header": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Header",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "type": {
          "const": "table",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "header",
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "WordMeta": {
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "classification": {
          "default": "内部公开",
          "description": "页脚和文档头共用的受控密级文案。",
          "title": "Classification",
          "type": "string"
        },
        "document_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选华为详设文档控制信息；存在时在正文前渲染产品/版本表和拟制审核批准表。"
        },
        "footer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer Text"
        },
        "header_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Text"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "WordMeta",
      "type": "object"
    }
  },
  "properties": {
    "blocks": {
      "items": {
        "discriminator": {
          "mapping": {
            "bullet_list": "#/$defs/BulletListBlock",
            "code_block": "#/$defs/CodeBlock",
            "heading": "#/$defs/HeadingBlock",
            "image_placeholder": "#/$defs/ImagePlaceholderBlock",
            "numbered_list": "#/$defs/NumberedListBlock",
            "page_break": "#/$defs/PageBreakBlock",
            "paragraph": "#/$defs/ParagraphBlock",
            "table": "#/$defs/TableBlock"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HeadingBlock"
          },
          {
            "$ref": "#/$defs/ParagraphBlock"
          },
          {
            "$ref": "#/$defs/CodeBlock"
          },
          {
            "$ref": "#/$defs/BulletListBlock"
          },
          {
            "$ref": "#/$defs/NumberedListBlock"
          },
          {
            "$ref": "#/$defs/TableBlock"
          },
          {
            "$ref": "#/$defs/ImagePlaceholderBlock"
          },
          {
            "$ref": "#/$defs/PageBreakBlock"
          }
        ]
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "ir_type": {
      "const": "word",
      "title": "Ir Type",
      "type": "string"
    },
    "ir_version": {
      "const": "1.3",
      "title": "Ir Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/WordMeta"
    }
  },
  "required": [
    "ir_type",
    "ir_version",
    "meta",
    "blocks"
  ],
  "title": "WordIR",
  "type": "object"
}
