{
  "$defs": {
    "BulletListBlock": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "bullet_list",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "BulletListBlock",
      "type": "object"
    },
    "HeadingBlock": {
      "properties": {
        "level": {
          "maximum": 4,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "heading",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "text"
      ],
      "title": "HeadingBlock",
      "type": "object"
    },
    "ImagePlaceholderBlock": {
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "type": {
          "const": "image_placeholder",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ImagePlaceholderBlock",
      "type": "object"
    },
    "ListItem": {
      "properties": {
        "level": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ListItem",
      "type": "object"
    },
    "NumberedListBlock": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "numbered_list",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "NumberedListBlock",
      "type": "object"
    },
    "PageBreakBlock": {
      "properties": {
        "type": {
          "const": "page_break",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PageBreakBlock",
      "type": "object"
    },
    "ParagraphBlock": {
      "properties": {
        "style": {
          "default": "normal",
          "enum": [
            "normal",
            "quote",
            "note"
          ],
          "title": "Style",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "paragraph",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "ParagraphBlock",
      "type": "object"
    },
    "TableBlock": {
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "col_widths": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col Widths"
        },
        "header": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Header",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 100,
          "title": "Rows",
          "type": "array"
        },
        "type": {
          "const": "table",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "header",
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "WordMeta": {
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "classification": {
          "default": "内部公开",
          "title": "Classification",
          "type": "string"
        },
        "footer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer Text"
        },
        "header_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Text"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "WordMeta",
      "type": "object"
    }
  },
  "properties": {
    "blocks": {
      "items": {
        "discriminator": {
          "mapping": {
            "bullet_list": "#/$defs/BulletListBlock",
            "heading": "#/$defs/HeadingBlock",
            "image_placeholder": "#/$defs/ImagePlaceholderBlock",
            "numbered_list": "#/$defs/NumberedListBlock",
            "page_break": "#/$defs/PageBreakBlock",
            "paragraph": "#/$defs/ParagraphBlock",
            "table": "#/$defs/TableBlock"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HeadingBlock"
          },
          {
            "$ref": "#/$defs/ParagraphBlock"
          },
          {
            "$ref": "#/$defs/BulletListBlock"
          },
          {
            "$ref": "#/$defs/NumberedListBlock"
          },
          {
            "$ref": "#/$defs/TableBlock"
          },
          {
            "$ref": "#/$defs/ImagePlaceholderBlock"
          },
          {
            "$ref": "#/$defs/PageBreakBlock"
          }
        ]
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "ir_type": {
      "const": "word",
      "title": "Ir Type",
      "type": "string"
    },
    "ir_version": {
      "const": "1.0",
      "title": "Ir Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/WordMeta"
    }
  },
  "required": [
    "ir_type",
    "ir_version",
    "meta",
    "blocks"
  ],
  "title": "WordIR",
  "type": "object"
}
