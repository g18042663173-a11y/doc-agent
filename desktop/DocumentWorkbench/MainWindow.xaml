<Window x:Class="DocumentWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="文档生成工作台"
        Icon="Assets/app-icon.ico"
        Width="1280" Height="820" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F7F8FA" />
        <SolidColorBrush x:Key="NavigationBrush" Color="#202328" />
        <SolidColorBrush x:Key="NavigationHoverBrush" Color="#30343A" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2329" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#646A73" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DADDE3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C7002B" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#A80024" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#1D7A46" />
        <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="FocusBrush" Color="#3A7AFE" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F1F3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#E8B4AE" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E9EAEC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <Border x:Name="NavMarker" Width="3" HorizontalAlignment="Left"
                                        Margin="0,8" Background="Transparent" CornerRadius="2" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource NavigationHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="NavBorder" Property="Background" Value="#393D44" />
                                <Setter TargetName="NavMarker" Property="Background" Value="#F23D61" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#8FB4FF" />
                                <Setter TargetName="NavBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected">
                    <Setter Property="Background" Value="#FDECEF" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavigationBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="78" />
                </Grid.RowDefinitions>
                <StackPanel Margin="22,20,16,0">
                    <TextBlock Text="文档生成工作台" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SidebarVersionText" Text="正在连接本地服务" Foreground="#AEB3BA" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="GenerateNavButton" Content="生成" Style="{StaticResource NavButton}" Tag="selected"
                            Click="GenerateNavButton_Click" automation:AutomationProperties.AutomationId="nav-generate" />
                    <Button x:Name="TasksNavButton" Content="任务" Style="{StaticResource NavButton}"
                            Click="TasksNavButton_Click" automation:AutomationProperties.AutomationId="nav-tasks" />
                    <Button x:Name="SettingsNavButton" Content="设置" Style="{StaticResource NavButton}"
                            Click="SettingsNavButton_Click" automation:AutomationProperties.AutomationId="nav-settings" />
                    <Button x:Name="DiagnosticsNavButton" Content="诊断" Style="{StaticResource NavButton}"
                            Click="DiagnosticsNavButton_Click" automation:AutomationProperties.AutomationId="nav-diagnostics" />
                    <Button x:Name="AboutNavButton" Content="关于" Style="{StaticResource NavButton}"
                            Click="AboutNavButton_Click" automation:AutomationProperties.AutomationId="nav-about" />
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#3B3F45" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,1,8,0" />
                            <TextBlock x:Name="ServiceStateText" Text="正在启动" Foreground="#E9EAEC" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="GeneratorStateText" Text="生成器：stub" Foreground="#AEB3BA" FontSize="12" Margin="16,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <TextBlock x:Name="TopbarTitleText" Text="生成" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="TopbarStatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22,28,24">
                <ScrollViewer x:Name="GeneratePage" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
                        <TextBlock Text="创建文档" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="选择资料与输出类型，提交后可随时查看阶段、取消任务或下载审计文件。"
                                   Style="{StaticResource MutedText}" Margin="0,0,0,20" />

                        <Border Style="{StaticResource GroupPanel}">
                            <StackPanel>
                                <TextBlock Text="输入与输出" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="输入资料" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InputFileTextBox" IsReadOnly="True" Text="尚未选择文件"
                                             automation:AutomationProperties.Name="输入资料路径" />
                                    <Button Grid.Column="1" Content="选择文件" Margin="8,0,0,0" Click="BrowseInput_Click"
                                            automation:AutomationProperties.AutomationId="select-input" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="输出类型" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="TargetComboBox" SelectionChanged="TargetComboBox_SelectionChanged"
                                                  automation:AutomationProperties.AutomationId="target-type">
                                            <ComboBoxItem Tag="deck">PowerPoint 演示文稿</ComboBoxItem>
                                            <ComboBoxItem Tag="word">Word 文档</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="DepthPanel" Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="内容深度" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DepthComboBox" automation:AutomationProperties.AutomationId="deck-depth">
                                            <ComboBoxItem>概览</ComboBoxItem>
                                            <ComboBoxItem>标准</ComboBoxItem>
                                            <ComboBoxItem>详细</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="InputLimitText" Text="支持 MD、DOCX、XLSX、PPTX，最大 100 MB"
                                                   Style="{StaticResource MutedText}" Margin="0,0,0,9" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DeckOptionsPanel" Style="{StaticResource GroupPanel}">
                            <StackPanel>
                                <TextBlock Text="模板与图片" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="PPT 模板" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TemplateFileTextBox" IsReadOnly="True" Text="使用默认主题"
                                             automation:AutomationProperties.Name="PPT 模板路径" />
                                    <Button Grid.Column="1" Content="选择模板" Margin="8,0,0,0" Click="BrowseTemplate_Click"
                                            automation:AutomationProperties.AutomationId="select-template" />
                                    <Button Grid.Column="2" Content="移除" Margin="8,0,0,0" Click="RemoveTemplate_Click" />
                                </Grid>
                                <TextBlock Text="图片资产" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="AssetListBox" MinHeight="58" MaxHeight="112"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             automation:AutomationProperties.Name="已选图片资产" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Button Content="添加图片" Click="AddAssets_Click" Width="104"
                                                automation:AutomationProperties.AutomationId="add-assets" />
                                        <Button Content="全部移除" Click="ClearAssets_Click" Width="104" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="PNG、JPEG 或 WebP；最多 20 张，单张不超过 20 MB。"
                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AnalysisPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="资料分析" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                    <TextBlock x:Name="RecommendedDepthText" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock x:Name="AnalysisMetricsText" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="AnalysisReasonText" Style="{StaticResource MutedText}" />
                                <ItemsControl x:Name="AnalysisTiersItems" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DepthRange}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Coverage}" Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                            <Button x:Name="AnalyzeButton" Content="分析资料" Click="Analyze_Click" MinWidth="112"
                                    automation:AutomationProperties.AutomationId="analyze" />
                            <Button x:Name="GenerateButton" Content="开始生成" Style="{StaticResource PrimaryButton}"
                                    Click="Generate_Click" MinWidth="132" Margin="10,0,0,0"
                                    automation:AutomationProperties.AutomationId="generate" />
                            <TextBlock x:Name="GenerateGuardText" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>

                        <Border x:Name="ProgressPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="ProgressTitleText" Text="等待执行" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <ProgressBar x:Name="JobProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="StageTrackText" Text="排队 → 解析 → 生成 → 渲染 → 检查"
                                           Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                <Button x:Name="CancelButton" Content="取消任务" Style="{StaticResource DangerButton}"
                                        Click="Cancel_Click" HorizontalAlignment="Left" Margin="0,14,0,0"
                                        automation:AutomationProperties.AutomationId="cancel-job" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ResultPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ResultTitleText" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ResultDetailText" Margin="0,0,0,10" />
                                <TextBlock x:Name="ResultSupportText" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DownloadOutputButton" Content="下载产物" Style="{StaticResource PrimaryButton}"
                                            Click="DownloadOutput_Click" Visibility="Collapsed"
                                            automation:AutomationProperties.AutomationId="download-output" />
                                    <Button x:Name="RetryButton" Content="重新提交" Click="Retry_Click" Margin="8,0,0,0"
                                            Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="AuditTitleText" Text="审计文件" Style="{StaticResource FieldLabel}"
                                           Margin="0,16,0,6" Visibility="Collapsed" />
                                <ListBox x:Name="AuditAssetsListBox" DisplayMemberPath="Label" Visibility="Collapsed"
                                         MinHeight="44" MaxHeight="160" MouseDoubleClick="AuditAssetsListBox_MouseDoubleClick"
                                         automation:AutomationProperties.Name="审计文件列表" />
                                <Button x:Name="DownloadAuditButton" Content="下载所选审计文件" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Visibility="Collapsed" Click="DownloadAudit_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="TasksPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="任务" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="本机最近 24 小时的任务状态与结果。" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Button Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshTasks_Click"
                                automation:AutomationProperties.AutomationId="refresh-tasks" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource GroupPanel}" Margin="0,18,0,14" Padding="0">
                        <DataGrid x:Name="JobsDataGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0"
                                  automation:AutomationProperties.Name="任务列表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务" Binding="{Binding DisplayId}" Width="145" />
                                <DataGridTextColumn Header="类型" Binding="{Binding DisplayType}" Width="80" />
                                <DataGridTextColumn Header="深度" Binding="{Binding Depth}" Width="90" />
                                <DataGridTextColumn Header="生成器" Binding="{Binding DisplayGenerator}" Width="100" />
                                <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus}" Width="100" />
                                <DataGridTextColumn Header="阶段" Binding="{Binding DisplayStage}" Width="160" />
                                <DataGridTextColumn Header="进度" Binding="{Binding Progress.Percent, StringFormat={}{0}%}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="查看详情" Click="OpenSelectedTask_Click" />
                        <Button Content="下载产物" Click="DownloadSelectedTask_Click" Margin="8,0,0,0" />
                        <Button Content="取消任务" Style="{StaticResource DangerButton}" Click="CancelSelectedTask_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="生成器、默认值、存储和隐私控制。" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Button x:Name="GeneralSettingsButton" Content="常规" Style="{StaticResource SubNavButton}" Tag="selected" Click="GeneralSettings_Click" />
                            <Button x:Name="NgaSettingsButton" Content="NGA" Style="{StaticResource SubNavButton}" Click="NgaSettings_Click" />
                            <Button x:Name="StorageSettingsButton" Content="存储" Style="{StaticResource SubNavButton}" Click="StorageSettings_Click" />
                            <Button x:Name="PrivacySettingsButton" Content="隐私" Style="{StaticResource SubNavButton}" Click="PrivacySettings_Click" />
                            <Button x:Name="SettingsAboutButton" Content="关于" Style="{StaticResource SubNavButton}" Click="SettingsAbout_Click" />
                        </StackPanel>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Border x:Name="GeneralSettingsPanel" Style="{StaticResource GroupPanel}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="常规" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="默认输出类型" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DefaultTargetComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                                            <ComboBoxItem Tag="deck">PowerPoint 演示文稿</ComboBoxItem>
                                            <ComboBoxItem Tag="word">Word 文档</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock Text="默认 PPT 深度" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DefaultDepthComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,18">
                                            <ComboBoxItem>概览</ComboBoxItem>
                                            <ComboBoxItem>标准</ComboBoxItem>
                                            <ComboBoxItem>详细</ComboBoxItem>
                                        </ComboBox>
                                        <Button Content="保存常规设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveGeneralSettings_Click" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="NgaSettingsPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="NGA" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="NgaActiveStateText" Text="当前生成器：stub" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="服务地址" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="NgaBaseUrlTextBox" Margin="0,0,0,12" automation:AutomationProperties.AutomationId="nga-base-url" />
                                                <TextBlock Text="接口路径" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="NgaEndpointTextBox" Margin="0,0,0,12" automation:AutomationProperties.AutomationId="nga-endpoint" />
                                                <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="NgaModelTextBox" Margin="0,0,0,12" automation:AutomationProperties.AutomationId="nga-model" />
                                                <TextBlock Text="Bearer Token" Style="{StaticResource FieldLabel}" />
                                                <PasswordBox x:Name="NgaTokenPasswordBox" Margin="0,0,0,4" automation:AutomationProperties.AutomationId="nga-token" />
                                                <TextBlock x:Name="NgaCredentialStateText" Text="未保存凭据" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="超时（秒）" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="NgaTimeoutTextBox" Margin="0,0,0,12" />
                                                <TextBlock Text="重试次数" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="NgaRetriesComboBox" Margin="0,0,0,12">
                                                    <ComboBoxItem>0</ComboBoxItem><ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem>
                                                    <ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem><ComboBoxItem>5</ComboBoxItem>
                                                </ComboBox>
                                                <TextBlock Text="响应格式" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="NgaResponseFormatComboBox" Margin="0,0,0,12">
                                                    <ComboBoxItem Tag="json_object">JSON Object</ComboBoxItem>
                                                    <ComboBoxItem Tag="none">不声明</ComboBoxItem>
                                                </ComboBox>
                                                <CheckBox x:Name="NgaVerifyTlsCheckBox" Content="验证 TLS 证书" />
                                                <CheckBox x:Name="NgaAllowHttpCheckBox" Content="允许明文 HTTP（仅隔离测试）" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="自定义 CA 文件" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="NgaCaPathTextBox" IsReadOnly="True" />
                                            <Button Grid.Column="1" Content="选择 CA" Margin="8,0,0,0" Click="BrowseCa_Click" />
                                        </Grid>
                                        <WrapPanel>
                                            <Button x:Name="SaveNgaButton" Content="保存配置" Click="SaveNga_Click" />
                                            <Button x:Name="TestNgaButton" Content="测试连接" Click="TestNga_Click" Margin="8,0,0,0"
                                                    automation:AutomationProperties.AutomationId="test-nga" />
                                            <Button x:Name="ActivateNgaButton" Content="启用 NGA" Style="{StaticResource PrimaryButton}"
                                                    Click="ActivateNga_Click" Margin="8,0,0,0" automation:AutomationProperties.AutomationId="activate-nga" />
                                            <Button Content="切换到 Stub" Click="ActivateStub_Click" Margin="8,0,0,0" />
                                            <Button Content="删除 Token" Style="{StaticResource DangerButton}" Click="DeleteToken_Click" Margin="8,0,0,0" />
                                        </WrapPanel>
                                        <TextBlock x:Name="NgaOperationStatusText" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StorageSettingsPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="存储" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="任务目录" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="JobsPathTextBox" IsReadOnly="True" Margin="0,0,0,12" />
                                        <TextBlock Text="完成与失败任务保留 24 小时，敏感中间文件会在任务结束后清理。"
                                                   Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                                        <Button Content="打开任务目录" HorizontalAlignment="Left" Click="OpenJobsFolder_Click" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="PrivacySettingsPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="隐私" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="NGA Token 只保存在当前 Windows 用户的凭据管理器中。" Margin="0,0,0,10" />
                                        <TextBlock Text="设置文件、任务状态和失败报告不会保存 Token、原始 Prompt、模型原文或输入正文。" Margin="0,0,0,10" />
                                        <TextBlock Text="所有桌面 API 请求仅连接 127.0.0.1，并使用每次启动随机生成的会话密钥。" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SettingsAboutPanel" Style="{StaticResource GroupPanel}" Visibility="Collapsed" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="文档生成工作台 2.1.0" FontWeight="SemiBold" />
                                        <TextBlock Text="原生 .NET 8 WPF 客户端" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="诊断" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="运行状态与本机依赖，不显示凭据或文档正文。" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Button Content="刷新诊断" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshDiagnostics_Click"
                                    automation:AutomationProperties.AutomationId="refresh-diagnostics" />
                        </Grid>
                        <Border Style="{StaticResource GroupPanel}" Margin="0,18,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                                    <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                                    <RowDefinition Height="34" /><RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="应用版本" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticAppVersion" Grid.Column="1" />
                                <TextBlock Text="API / DeckIR" Grid.Row="1" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticApiVersion" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Text="当前生成器" Grid.Row="2" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticGenerator" Grid.Row="2" Grid.Column="1" />
                                <TextBlock Text="任务队列" Grid.Row="3" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticQueue" Grid.Row="3" Grid.Column="1" />
                                <TextBlock Text="任务统计" Grid.Row="4" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticJobs" Grid.Row="4" Grid.Column="1" />
                                <TextBlock Text="可用磁盘" Grid.Row="5" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticDisk" Grid.Row="5" Grid.Column="1" />
                                <TextBlock Text="Graphviz" Grid.Row="6" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticGraphviz" Grid.Row="6" Grid.Column="1" />
                                <TextBlock Text="NGA 连通状态" Grid.Row="7" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticNga" Grid.Row="7" Grid.Column="1" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DiagnosticUpdatedText" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Text="文档生成工作台" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="2.1.0 · Windows x64" Style="{StaticResource MutedText}" Margin="0,0,0,22" />
                        <Border Style="{StaticResource GroupPanel}">
                            <StackPanel>
                                <TextBlock Text="运行边界" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="文档生成使用经过 Schema 校验的 IR 和本地确定性渲染。NGA 只负责生成候选 IR，不能直接调用渲染器。" Margin="0,0,0,12" />
                                <TextBlock Text="浏览器工作台仍可独立使用；原生客户端不使用 WebView2、Electron 或 HTML PPT 渲染。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupPanel}">
                            <StackPanel>
                                <TextBlock Text="交付信息" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="产品图标和界面采用中性设计，红色仅用于主操作与关键状态。" />
                                <TextBlock Text="正式推广前需要内网代码签名证书与干净断网 Windows 机器验收。" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
